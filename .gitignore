# ephemeral / per-box — never committed, keeps the repo clean (no spam in git status)
__pycache__/
*.egg-info/
.pytest_cache/
.venv/
.mbx/
models/
.env
cluster.yaml
dashboards/*/src/       # a dashboard's cloned upstream (e.g. sparkDash checkout)
dashboards/*/config/    # a dashboard's generated, machine-specific config (box IPs, etc.)
