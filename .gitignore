# ephemeral / per-box — never committed, keeps the repo clean (no spam in git status)
__pycache__/
*.egg-info/
.pytest_cache/
.venv/
.mbx/
models/
.env
cluster.yaml
# a dashboard's cloned upstream (e.g. sparkDash checkout)
dashboards/*/src/
# a dashboard's generated, machine-specific config (box IPs, ssh users, etc.)
dashboards/*/config/
