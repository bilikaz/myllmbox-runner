# ephemeral / per-box — never committed, keeps the repo clean (no spam in git status)
__pycache__/
*.egg-info/
.pytest_cache/
.venv/
.mbx/
models/
.env
cluster.yaml
# a dashboard's runtime data — the ONE ignored dir per dashboard: cloned/built upstream,
# regenerated machine-specific config (box IPs, ssh users), any generated key. Never committed.
dashboards/*/.data/
