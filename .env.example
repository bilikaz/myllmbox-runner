# Both tokens come from the myllmbox console — Names page → Box setup reveal.
# Required: connects the platform-provisioned tunnel (task11 creates tunnel + ingress + DNS for you).
TUNNEL_TOKEN=
# Optional: gates the generation endpoints (/v1/chat/completions, …). LEAVE EMPTY and the whole box is
# public — generation included. /v1/models is public either way (the model card).
BINDING_TOKEN=
# Optional: your public URL (https://hub-you.myllmbox.com) — used only by `mbx-runner status` to probe
# through the edge.
PUBLIC_URL=
# Optional: password for a recipe's dashboard (see `dashboard:` in a recipe). When set, the proxy fronts
# every non-/v1 path with the dashboard behind HTTP Basic auth (any username, this password). Leave empty
# and the dashboard is NOT exposed through the proxy (the box stays model-only).
DASHBOARD_PASSWORD=
